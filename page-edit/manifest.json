{
  "manifest_version": 3,
  "name": "page-edit",
  "version": "3.11",
  "description": "Edit the text of a WebSlide slide or a Kamishibai draft opened as a local file (file://) and write it back to the draft, through a folder the author allows once (File System Access API). No server, no native host.",
  "key": "",
  "content_scripts": [
    {
      "matches": [
        "file:///*"
      ],
      "js": [
        "edit.js"
      ],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ]
}
